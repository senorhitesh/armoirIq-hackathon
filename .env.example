# ArmorIQ API Configuration (from platform.armoriq.ai)
ARMORIQ_API_KEY=your_armoriq_api_key

# Neon Postgres Database URL (optional, falls back to in-memory store)
DATABASE_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# ElevenLabs Voice API Key (optional, falls back to Web Speech API)
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Model Provider (Google Gemini / OpenAI / Groq)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key
